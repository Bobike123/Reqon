{
  "name": "reqon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.7"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "predev": "node scripts/local-setup.mjs --predev",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs",
    "lint": "oxlint src vite.config.ts scripts --ignore-path .gitignore && node scripts/check-boundaries.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:coverage": "vitest run --coverage",
    "types:gen": "node scripts/gen-types.mjs",
    "types:gen:local": "bash scripts/gen-types-local.sh",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:db": "bash scripts/verify_db.sh",
    "archive:sweep": "node scripts/run-archive-sweep.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "local:setup": "node scripts/local-setup.mjs",
    "book:sync:local": "node scripts/book/sync-local.mjs",
    "book:upload:hosted": "node scripts/book/upload-hosted.mjs",
    "data:reconcile:check": "node scripts/data-rebuild/gen-reconciliation-data.mjs --check",
    "data:rehearse": "bash scripts/data-rebuild/rehearse-hosted-snapshot.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
